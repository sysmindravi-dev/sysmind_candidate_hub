DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
APP_ENCRYPTION_KEY=replace-with-fernet-key
ALLOWED_HOSTS=your-app.ondigitalocean.app
CSRF_TRUSTED_ORIGINS=https://your-app.ondigitalocean.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
TIME_ZONE=America/New_York

# Only required if using SignalHire async callback mode
SIGNALHIRE_CALLBACK_BASE_URL=https://your-app.ondigitalocean.app

# Optional DigitalOcean Spaces. Recommended in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
AWS_S3_REGION_NAME=nyc3
